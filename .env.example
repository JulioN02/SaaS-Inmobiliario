# =============================================================================
# SaaS Inmobiliario — Variables de Entorno
# Copiar a .env y ajustar según el entorno
# =============================================================================

# ── Backend ───────────────────────────────────────────────────────────────────

# Puerto del servidor backend
PORT=3000

# Base de datos PostgreSQL
DATABASE_URL="postgresql://saas_admin:saas_dev_password_2026@localhost:5435/saas_inmobiliario"

# JWT
JWT_SECRET="supersecretsaasjwt_2026_desarrollo"
JWT_EXPIRES_IN="1h"

# Super Admin
PLATFORM_TENANT_ID="00000000-0000-0000-0000-000000000000"
SUPER_ADMIN_EMAIL="admin@platform.com"
SUPER_ADMIN_PASSWORD="Admin_Pass_2026!"

# CORS (separados por coma)
CORS_ORIGINS="http://localhost:80,http://localhost:5173,http://localhost:3000"

# ── Frontend (Vite) ─────────────────────────────────────────────────────────

# URL base de la API (relativa para Docker, absoluta para desarrollo local)
VITE_API_URL="http://localhost:3000/api/v1"

# ── Docker Compose ────────────────────────────────────────────────────────────

# Puerto del frontend en el host
FRONTEND_PORT=80

# Puerto de la DB en el host (5435 evita conflicto con PostgreSQL local)
DB_PORT_HOST=5435

# Puerto de la DB de test en el host
TEST_DB_PORT=5436

# PostgreSQL (usuario por defecto)
POSTGRES_USER=saas_admin
POSTGRES_PASSWORD=saas_dev_password_2026
POSTGRES_DB=saas_inmobiliario
