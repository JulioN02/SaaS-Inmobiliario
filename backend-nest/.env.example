# SaaS Inmobiliario — Variables de Entorno (NestJS)

# Base de datos
DATABASE_URL="postgresql://saas_admin:password@localhost:5432/saas_inmobiliario"

# JWT
JWT_SECRET="cambiar_esto_por_un_secret_largo_y_aleatorio"
JWT_EXPIRES_IN="1h"

# Servidor
PORT=3000
NODE_ENV="development"

# Multi-tenant
PLATFORM_TENANT_ID="00000000-0000-0000-0000-000000000000"

# Super Admin (seed)
SUPER_ADMIN_EMAIL="admin@platform.com"
SUPER_ADMIN_PASSWORD="Admin_Pass_2026!"

# Auto-suspensión de suscripciones (requiere @nestjs/schedule)
# AUTO_SUSPENSION_ENABLED=true

# Stripe (opcional — si no se configura, usa NullPaymentGateway offline)
# STRIPE_SECRET_KEY="sk_test_..."
