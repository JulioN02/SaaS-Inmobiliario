// =============================================================================
// prisma/schema.prisma
// SaaS Inmobiliario — Monolito Modular Multi-Tenant
// Fuente de verdad: openapi.yaml + AGENTS.md + Documento Formal de Reglas de Negocio
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// ENUMS
// =============================================================================

enum UserRole {
  SUPER_ADMIN
  ADMIN_TENANT
  ADMINISTRATIVA
  PORTERIA
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  INACTIVE
}

enum TenantPlan {
  BASIC
  PREMIUM
  ENTERPRISE
}

enum PropertyType {
  CONJUNTO
  EDIFICIO
  TORRE
  CASA_INDEPENDIENTE
}

enum UnitType {
  APARTMENT
  HOUSE
  COMMERCIAL
  PARKING
}

enum UnitStatus {
  AVAILABLE
  OCCUPIED
  MAINTENANCE
}

enum OccupancyType {
  OWNER
  TENANT
}

enum DocumentType {
  CC
  CE
  PASSPORT
  NIT
}

enum FeeType {
  PERIODIC
  EXTRAORDINARY
  ADJUSTMENT
}

enum FeeStatus {
  PENDING
  PAID
  PARTIAL
}

enum MaintenanceStatus {
  PENDING
  IN_PROGRESS
  RESOLVED
  CANCELLED
}

enum PermissionAction {
  read
  create
  update
  delete
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  SUSPEND
  ACTIVATE
  STATUS_CHANGE
  ROLE_CHANGE
}

enum AuditEntity {
  tenant
  user
  property
  tower
  unit
  resident
  occupancy
  fee
  maintenance
  visitor
  announcement
  website
}

// =============================================================================
// CORE SAAS
// =============================================================================

model Tenant {
  id           String       @id @default(uuid())
  name         String       @db.VarChar(100)
  subdomain    String       @unique @db.VarChar(50)
  plan         TenantPlan   @default(BASIC)
  status       TenantStatus @default(ACTIVE)
  contactEmail String?      @db.VarChar(255)
  contactPhone String?      @db.VarChar(30)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  deletedAt    DateTime?

  users         User[]
  properties    Property[]
  residents     Resident[]
  announcements Announcement[]
  websiteConfig WebsiteConfig?
  auditLogs     AuditLog[]

  @@index([status])
  @@map("tenants")
}

model Role {
  id          String   @id @default(uuid())
  name        UserRole @unique
  description String?  @db.VarChar(255)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions RolePermission[]
  users       User[]

  @@map("roles")
}

model Permission {
  id       String           @id @default(uuid())
  resource String           @db.VarChar(50)
  action   PermissionAction

  roles RolePermission[]

  @@unique([resource, action])
  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model User {
  id        String    @id @default(uuid())
  tenantId  String
  roleId    String
  email     String    @db.VarChar(255)
  password  String    @db.VarChar(255)
  role      UserRole
  firstName String?   @db.VarChar(50)
  lastName  String?   @db.VarChar(50)
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  tenant               Tenant         @relation(fields: [tenantId], references: [id])
  roleRef              Role           @relation(fields: [roleId], references: [id])
  announcementsCreated Announcement[] @relation("AnnouncementCreator")

  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([tenantId, isActive])
  @@map("users")
}

// =============================================================================
// DOMINIO INMOBILIARIO
// =============================================================================

model Property {
  id           String       @id @default(uuid())
  tenantId     String
  name         String       @db.VarChar(100)
  propertyType PropertyType
  address      String?      @db.VarChar(200)
  description  String?      @db.VarChar(500)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  deletedAt    DateTime?

  tenant Tenant  @relation(fields: [tenantId], references: [id])
  towers Tower[]
  units  Unit[]

  @@index([tenantId])
  @@index([tenantId, deletedAt])
  @@map("properties")
}

model Tower {
  id          String    @id @default(uuid())
  tenantId    String
  propertyId  String
  name        String    @db.VarChar(50)
  floorsCount Int?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  property Property @relation(fields: [propertyId], references: [id])
  units    Unit[]

  @@index([tenantId])
  @@index([propertyId])
  @@map("towers")
}

model Unit {
  id               String     @id @default(uuid())
  tenantId         String
  propertyId       String
  towerId          String?
  identifier       String     @db.VarChar(20)
  unitType         UnitType
  floor            Int?
  status           UnitStatus @default(AVAILABLE)
  monthlyFeeAmount Decimal?   @db.Decimal(12, 2)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  deletedAt        DateTime?

  property        Property             @relation(fields: [propertyId], references: [id])
  tower           Tower?               @relation(fields: [towerId], references: [id])
  occupancies     Occupancy[]
  fees            Fee[]
  maintenanceReqs MaintenanceRequest[]
  visitors        Visitor[]

  @@unique([propertyId, identifier])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([propertyId])
  @@index([towerId])
  @@map("units")
}

model Resident {
  id               String       @id @default(uuid())
  tenantId         String
  firstName        String       @db.VarChar(50)
  lastName         String       @db.VarChar(50)
  documentType     DocumentType
  documentNumber   String       @db.VarChar(20)
  email            String?      @db.VarChar(255)
  phone            String?      @db.VarChar(30)
  emergencyContact String?      @db.VarChar(100)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  deletedAt        DateTime?

  tenant      Tenant      @relation(fields: [tenantId], references: [id])
  occupancies Occupancy[]

  @@unique([tenantId, documentNumber])
  @@index([tenantId])
  @@map("residents")
}

model Occupancy {
  id         String        @id @default(uuid())
  tenantId   String
  unitId     String
  residentId String
  type       OccupancyType
  startDate  DateTime      @db.Date
  endDate    DateTime?     @db.Date
  notes      String?       @db.VarChar(500)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  unit     Unit     @relation(fields: [unitId], references: [id])
  resident Resident @relation(fields: [residentId], references: [id])

  @@index([tenantId])
  @@index([unitId])
  @@index([residentId])
  @@index([unitId, endDate])
  @@map("occupancies")
}

// =============================================================================
// DOMINIO OPERATIVO
// =============================================================================

model Fee {
  id          String    @id @default(uuid())
  tenantId    String
  unitId      String
  type        FeeType
  amount      Decimal   @db.Decimal(12, 2)
  period      String    @db.VarChar(7)
  status      FeeStatus @default(PENDING)
  paidAmount  Decimal?  @db.Decimal(12, 2)
  paidAt      DateTime?
  dueDate     DateTime? @db.Date
  description String?   @db.VarChar(200)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  unit    Unit               @relation(fields: [unitId], references: [id])
  history FeeStatusHistory[]

  @@index([tenantId])
  @@index([unitId])
  @@index([tenantId, period])
  @@index([tenantId, status])
  @@map("fees")
}

model FeeStatusHistory {
  id         String     @id @default(uuid())
  tenantId   String
  feeId      String
  fromStatus FeeStatus?
  toStatus   FeeStatus
  paidAmount Decimal?   @db.Decimal(12, 2)
  notes      String?    @db.VarChar(300)
  changedBy  String     @db.VarChar(36)
  changedAt  DateTime   @default(now())

  fee Fee @relation(fields: [feeId], references: [id])

  @@index([feeId])
  @@index([tenantId])
  @@map("fee_status_history")
}

model MaintenanceRequest {
  id          String            @id @default(uuid())
  tenantId    String
  unitId      String
  title       String            @db.VarChar(100)
  description String?           @db.VarChar(500)
  status      MaintenanceStatus @default(PENDING)
  assignedTo  String?           @db.VarChar(100)
  resolvedAt  DateTime?
  createdBy   String            @db.VarChar(36)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  unit Unit @relation(fields: [unitId], references: [id])

  @@index([tenantId])
  @@index([unitId])
  @@index([tenantId, status])
  @@map("maintenance_requests")
}

model Visitor {
  id             String    @id @default(uuid())
  tenantId       String
  unitId         String
  visitorName    String    @db.VarChar(100)
  documentNumber String?   @db.VarChar(20)
  entryDate      DateTime
  exitDate       DateTime?
  notes          String?   @db.VarChar(200)
  registeredBy   String    @db.VarChar(36)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  unit Unit @relation(fields: [unitId], references: [id])

  @@index([tenantId])
  @@index([unitId])
  @@index([tenantId, entryDate])
  @@map("visitors")
}

enum AnnouncementPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

model Announcement {
  id          String               @id @default(uuid())
  tenantId    String
  title       String               @db.VarChar(255)
  content     String               @db.VarChar(2000)
  priority    AnnouncementPriority @default(NORMAL)
  targetRoles UserRole[]
  targetUnits String[]
  startsAt    DateTime?
  endsAt      DateTime?
  isActive    Boolean              @default(true)
  createdBy   String               @db.VarChar(36)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  deletedAt   DateTime?

  tenant        Tenant @relation(fields: [tenantId], references: [id])
  createdByUser User   @relation("AnnouncementCreator", fields: [createdBy], references: [id])

  @@index([tenantId])
  @@index([tenantId, isActive])
  @@index([tenantId, deletedAt])
  @@map("announcements")
}

model WebsiteConfig {
  id                String   @id @default(uuid())
  tenantId          String   @unique
  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  // Visual config
  logoUrl           String?
  primaryColor      String   @default("#2563EB")
  secondaryColor    String   @default("#10B981")
  backgroundColor   String   @default("#FFFFFF")
  
  // Text content
  siteTitle         String   @default("Portal Inmobiliario")
  welcomeMessage    String?  // Max 500 chars
  contactEmail      String?
  contactPhone      String?
  address           String?
  
  // SEO
  metaTitle         String?
  metaDescription   String?
  
  // Feature flags
  isMaintenanceMode Boolean  @default(false)
  isPublic         Boolean  @default(true)
  
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  
  @@map("website_configs")
}

// =============================================================================
// AUDIT
// =============================================================================

model AuditLog {
  id        String      @id @default(uuid())
  tenantId  String
  userId    String      @db.VarChar(36)
  entity    AuditEntity
  entityId  String      @db.VarChar(36)
  action    AuditAction
  snapshot  Json?
  ipAddress String?     @db.VarChar(45)
  timestamp DateTime    @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([tenantId, entity])
  @@index([tenantId, timestamp])
  @@index([userId])
  @@map("audit_logs")
}
