{
  "name": "backend-nest",
  "version": "1.0.0",
  "description": "SaaS Inmobiliario — Backend NestJS",
  "author": "Julio Nieto <jsoftsolutions1@gmail.com>",
  "license": "MIT",
  "type": "commonjs",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node -r ts-node/register/transpile-only -r tsconfig-paths/register src/main.ts",
    "start:prod:dist": "node -r tsconfig-paths/register dist/main",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "db:setup": "prisma migrate deploy && prisma db seed",
    "test:integration": "jest --config jest.integration.config.ts --no-cache",
    "db:test:setup": "DATABASE_URL=postgresql://saas_admin:saas_dev_password_2026@localhost:5435/saas_inmobiliario_test npx prisma migrate deploy",
    "db:test:create": "PGPASSWORD=saas_dev_password_2026 psql -h localhost -p 5435 -U saas_admin -d postgres -c 'CREATE DATABASE saas_inmobiliario_test;'",
    "db:test:drop": "PGPASSWORD=saas_dev_password_2026 psql -h localhost -p 5435 -U saas_admin -d postgres -c 'DROP DATABASE IF EXISTS saas_inmobiliario_test;'",
    "test:integration:setup": "npm run db:test:drop && npm run db:test:create && npm run db:test:setup"
  },
  "prisma": {
    "seed": "npx ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "^10.3.0",
    "@nestjs/config": "^3.1.1",
    "@nestjs/core": "^10.3.0",
    "@nestjs/platform-express": "^10.3.0",
    "@nestjs/swagger": "^7.1.17",
    "@prisma/client": "^5.7.0",
    "bcrypt": "^5.1.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.19",
    "@nestjs/testing": "^11.1.18",
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^25.5.2",
    "jest": "^30.3.0",
    "prisma": "^5.7.0",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.2"
  },
  "jest": {
    "moduleFileExtensions": ["js", "json", "ts"],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": ["**/*.(t|j)s"],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
