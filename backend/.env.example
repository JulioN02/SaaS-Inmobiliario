# =============================================================================
# SaaS Inmobiliario — Variables de Entorno
# Copiar este archivo a .env y completar los valores
# =============================================================================

# ── Base de Datos ────────────────────────────────────────────────────────────
# Formato: postgresql://user:password@host:port/database
DATABASE_URL="postgresql://saas_admin:password@localhost:5432/saas_inmobiliario"

# ── JWT (Autenticación) ──────────────────────────────────────────────────────
# Secret para firmar tokens JWT — USAR UN VALOR SEGURO EN PRODUCCIÓN
JWT_SECRET="cambiar_esto_por_un_secret_largo_y_aleatorio"
JWT_EXPIRES_IN="1h"

# ── Servidor ─────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV="development"  # development | test | production

# ── Multi-Tenant ─────────────────────────────────────────────────────────────
# ID del tenant plataforma (SuperAdmin). UUID de 36 caracteres.
# En desarrollo: generar con `uuidgen` o usar un valor fijo.
PLATFORM_TENANT_ID="00000000-0000-0000-0000-000000000000"

# ── Super Admin (seed inicial) ───────────────────────────────────────────────
# Credenciales del usuario SuperAdmin creado en el seed.
SUPER_ADMIN_EMAIL="admin@platform.com"
SUPER_ADMIN_PASSWORD="CambiarEnProduccion_2026!"

# ── Opcionales ───────────────────────────────────────────────────────────────
# LOG_LEVEL="info"
# CORS_ORIGIN="http://localhost:5173"
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX=100
